  "archive": [
    {
      "id": "felt",
      "name": "Felt",
      "years": "2014 to 2017",
      "lines": [
        "An app that sent real handwritten cards from your phone.",
        "I was the only backend engineer, working out of Telluride, Colorado. My title was Principal Engineer, Core Systems."
      ]
    },
    {
      "id": "sharktank",
      "name": "Shark Tank",
      "years": "The Felt years",
      "lines": [
        "Felt went on Shark Tank.",
        "My job was making sure the servers survived a whole TV audience finding out about us on the same night."
      ]
    },
    {
      "id": "microsoft",
      "name": "Microsoft",
      "years": "2017 to 2025",
      "lines": [
        "Technical Program Manager in the Seattle area for almost eight years.",
        "I shipped the Windows updates that go to every Windows device, then ran Windows OS delivery across Azure infrastructure.",
        "I coordinated release triage and security disclosures, and led the Hotpatch pilot on internal Azure services, which let them take security patches without rebooting."
      ]
    },
    {
      "id": "cre8r",
      "name": "CRE8R Club",
      "years": "2026",
      "lines": [
        "A vetted dinner club that matches creators into dinners of four to six people, twice a month, in Austin, LA and San Diego.",
        "I built the platform from scratch. Launching a new city means adding one file."
      ]
    },
    {
      "id": "rit",
      "name": "RIT",
      "years": "Rochester Institute of Technology",
      "lines": [
        "I played lacrosse.",
        "I was the only iOS developer on Commons, and I built the front end of Linkswag (it's in the Trash now)."
      ]
    }
  ],
  "trash": [
    {
      "id": "linkswag",
      "name": "Linkswag",
      "lines": [
        "From any website, you could share a link into one message board with your friends, and they could comment on it.",
        "We built it at RIT. The idea was right and the year was wrong."
      ]
