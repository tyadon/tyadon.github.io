  "readme": {
    "title": "Hi, I'm Trey.",
    "paragraphs": [
      "I build software, mostly apps people use with their friends. This is my computer. Poke around.",
      "Before this I spent almost eight years at Microsoft shipping the Windows updates that land on every Windows device. Before that I was the only backend engineer at Felt, a startup that mailed real handwritten cards from your phone, and I kept its servers up through a Shark Tank episode.",
      "I live in San Diego with my dog, Newton. I shoot on a Fuji X100VI and ride a Ducati.",
      "Double-click an icon to open it, or tap it on a phone. Newton wanders around on his own. If you stop by, sign the guestbook."
    ]
  },
  "projects": [
    {
      "id": "whosgotit",
      "name": "Who's Got It",
      "role": "Solo founder",
      "years": "2025 to now",
      "pitch": "An app for splitting a restaurant bill with friends. I built all of it: the iOS app, the web side and the backend.",
      "how": [
        "Take a photo of the receipt. An AI model reads the items, tax and tip.",
        "Text the group a link. Friends open it in their browser without downloading anything or making an account.",
        "Everyone taps what they ordered and pays you on Venmo. Payments show up on your phone as they come in.",
        "Trips mode is for group travel. Everyone adds bills along the way and claims what they had, and at the end the app works out the fewest payments needed to settle up."
      ],
      "stack": [
        "React Native (Expo)",
        "TypeScript",
        "Next.js",
        "Supabase"
      ],
      "links": [
        {
          "label": "App Store",
          "url": "https://apps.apple.com/us/app/whos-got-it/id6775676276"
        },
